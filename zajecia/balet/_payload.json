[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"{\"version\":\"draft\"}zajecia/balet":3},{"data":4,"headers":52},{"story":5,"cv":49,"rels":50,"links":51},{"name":6,"created_at":7,"published_at":8,"updated_at":9,"id":10,"uuid":11,"content":12,"slug":39,"full_slug":40,"sort_by_date":41,"position":42,"tag_list":43,"is_startpage":23,"parent_id":44,"meta_data":41,"group_id":45,"first_published_at":46,"release_id":41,"lang":47,"path":41,"alternates":48,"default_full_slug":41,"translated_slugs":41},"Balet","2026-05-29T15:27:48.544Z","2026-05-31T14:52:15.196Z","2026-05-31T14:52:15.212Z",181775845581519,"f4b0f889-d6c1-49b3-8878-77ec995ef37c",{"_uid":13,"body":14,"component":37,"_editable":38},"f60e9f23-22ff-4531-b05a-302e440a0458",[15,31],{"_uid":16,"icon":17,"image":24,"title":6,"component":28,"description":29,"_editable":30},"6b77c262-b265-4334-a815-920524b58abf",{"id":18,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":20,"copyright":19,"fieldtype":21,"meta_data":22,"is_external_url":23},182471862667422,"","https://a.storyblok.com/f/295402/3000x2000/00ef32596e/projekt-bez-nazwy-78.png","asset",{},false,{"id":25,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":26,"copyright":19,"fieldtype":21,"meta_data":27,"is_external_url":23},181776758086975,"https://a.storyblok.com/f/295402/1535x1024/b992209c8d/chatgpt-image-29-maj-2026-17_31_18.png",{},"ClassDetailsContent","Balet to klasyczna forma tańca, która rozwija nie tylko technikę ruchu, ale również grację, elegancję i świadomość własnego ciała. Zajęcia stanowią doskonałą podstawę dla wielu innych dyscyplin tanecznych i sportowych, ucząc prawidłowej postawy, koordynacji oraz płynności ruchów.\n\nPodczas treningów dzieci poznają podstawowe pozycje baletowe, kroki, obroty, skoki oraz ćwiczenia przy drążku i na środku sali. Zajęcia prowadzone są przy muzyce, dzięki czemu uczestnicy rozwijają poczucie rytmu, muzykalność\n i umiejętność interpretacji ruchu.\n\nRegularne ćwiczenia poprawiają gibkość, równowagę, siłę oraz wytrzymałość. Balet pomaga również kształtować koncentrację, cierpliwość i systematyczność, a także buduje pewność siebie i estetykę ruchu. Dzieci uczą się lekkości, precyzji oraz harmonii w wykonywaniu poszczególnych elementów.\n\nZajęcia prowadzone są w przyjaznej atmosferze, dostosowane do wieku i poziomu zaawansowania uczestników. Dzięki stopniowemu wprowadzaniu nowych umiejętności każde dziecko może rozwijać swoją pasję do tańca, czerpiąc radość z ruchu i artystycznej ekspresji.\n\n•••••••••••••••••••••••••••••••••••••••\n░░░ 𝐆𝐑𝐀𝐅𝐈𝐊 ░░░\n\nŚroda:\n16:30 - 4–7 lat","\u003C!--#storyblok#{\"name\": \"ClassDetailsContent\", \"space\": \"295402\", \"uid\": \"6b77c262-b265-4334-a815-920524b58abf\", \"id\": \"181775845581519\"}-->",{"_uid":32,"title":33,"images":34,"component":35,"_editable":36},"214d1813-4e15-43bb-a36f-8dceaa0c4a5b","TEST",[],"ClassGallery","\u003C!--#storyblok#{\"name\": \"ClassGallery\", \"space\": \"295402\", \"uid\": \"214d1813-4e15-43bb-a36f-8dceaa0c4a5b\", \"id\": \"181775845581519\"}-->","page","\u003C!--#storyblok#{\"name\": \"page\", \"space\": \"295402\", \"uid\": \"f60e9f23-22ff-4531-b05a-302e440a0458\", \"id\": \"181775845581519\"}-->","balet","zajecia/balet",null,-30,[],180832269008996,"62d454d3-46ca-4257-9e55-96a5210316d0","2026-05-31T13:21:37.762Z","default",[],1788773395,[],[],{"cache-control":53,"connection":54,"content-encoding":55,"content-type":56,"date":57,"etag":58,"referrer-policy":59,"sb-be-version":60,"server":61,"transfer-encoding":62,"vary":63,"via":64,"x-amz-cf-id":65,"x-amz-cf-pop":66,"x-cache":67,"x-content-type-options":68,"x-frame-options":69,"x-permitted-cross-domain-policies":70,"x-ratelimit":71,"x-ratelimit-policy":72,"x-request-id":73,"x-runtime":74,"x-xss-protection":75},"max-age=0, private, must-revalidate","keep-alive","gzip","application/json; charset=utf-8","Mon, 07 Sep 2026 09:38:15 GMT","W/\"f0dc1a145ff423927af45a62c90ead53\"","strict-origin-when-cross-origin","5.959.0","nginx/1.29.