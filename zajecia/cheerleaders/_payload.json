[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"{\"version\":\"draft\"}zajecia/cheerleaders":3},{"data":4,"headers":52},{"story":5,"cv":49,"rels":50,"links":51},{"name":6,"created_at":7,"published_at":8,"updated_at":9,"id":10,"uuid":11,"content":12,"slug":39,"full_slug":40,"sort_by_date":41,"position":42,"tag_list":43,"is_startpage":23,"parent_id":44,"meta_data":41,"group_id":45,"first_published_at":46,"release_id":41,"lang":47,"path":41,"alternates":48,"default_full_slug":41,"translated_slugs":41},"Cheerleaders","2026-05-29T15:33:52.050Z","2026-05-31T14:52:18.593Z","2026-05-31T14:52:18.605Z",181777334498138,"ec562684-3da9-4496-ab0b-9feed5478fef",{"_uid":13,"body":14,"component":37,"_editable":38},"f60e9f23-22ff-4531-b05a-302e440a0458",[15,31],{"_uid":16,"icon":17,"image":24,"title":6,"component":28,"description":29,"_editable":30},"6b77c262-b265-4334-a815-920524b58abf",{"id":18,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":20,"copyright":19,"fieldtype":21,"meta_data":22,"is_external_url":23},182471292020892,"","https://a.storyblok.com/f/295402/3000x2000/5b12c1eb85/projekt-bez-nazwy-76.png","asset",{},false,{"id":25,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":26,"copyright":19,"fieldtype":21,"meta_data":27,"is_external_url":23},181778434444653,"https://a.storyblok.com/f/295402/1921x819/8a5c5079cb/chatgpt-image-29-maj-2026-17_38_02.png",{},"ClassDetailsContent","Cheerleaders to pełne energii zajęcia łączące taniec, akrobatykę oraz elementy cheerleadingu sportowego. \nTo doskonała propozycja dla dzieci, które lubią ruch, muzykę \ni pracę w zespole. Treningi rozwijają sprawność fizyczną, koordynację oraz umiejętność współpracy, a jednocześnie dostarczają mnóstwo radości i pozytywnej energii.\n\nPodczas zajęć uczestnicy uczą się choreografii tanecznych, skoków, podstawowych elementów akrobatycznych, podnoszeń oraz efektownych układów grupowych. \nDzieci poznają również technikę pracy z pomponami, synchronizację ruchów oraz zasady bezpiecznego wykonywania elementów zespołowych.\n\nRegularne treningi poprawiają kondycję, gibkość, siłę\n i koordynację ruchową. Zajęcia pomagają rozwijać pewność siebie, poczucie rytmu, koncentrację oraz umiejętność działania w grupie. Wspólne przygotowywanie układów uczy odpowiedzialności, wzajemnego wsparcia i buduje sportowego ducha zespołu.\n\nZajęcia prowadzone są w przyjaznej atmosferze, dostosowane do wieku i poziomu zaawansowania uczestników. Dzięki połączeniu tańca, akrobatyki\n i zabawy dzieci mogą rozwijać swoje talenty, zdobywać nowe umiejętności oraz czerpać satysfakcję z występów i wspólnych sukcesów.\n\n•••••••••••••••••••••••••••••••••••••••\n░░░ 𝐆𝐑𝐀𝐅𝐈𝐊 ░░░\n\nCzwartek:\n18:30 - 7–10 lat","\u003C!--#storyblok#{\"name\": \"ClassDetailsContent\", \"space\": \"295402\", \"uid\": \"6b77c262-b265-4334-a815-920524b58abf\", \"id\": \"181777334498138\"}-->",{"_uid":32,"title":33,"images":34,"component":35,"_editable":36},"214d1813-4e15-43bb-a36f-8dceaa0c4a5b","TEST",[],"ClassGallery","\u003C!--#storyblok#{\"name\": \"ClassGallery\", \"space\": \"295402\", \"uid\": \"214d1813-4e15-43bb-a36f-8dceaa0c4a5b\", \"id\": \"181777334498138\"}-->","page","\u003C!--#storyblok#{\"name\": \"page\", \"space\": \"295402\", \"uid\": \"f60e9f23-22ff-4531-b05a-302e440a0458\", \"id\": \"181777334498138\"}-->","cheerleaders","zajecia/cheerleaders",null,-30,[],180832269008996,"409209d1-3768-4a66-84e8-b330a1346ef4","2026-05-31T13:21:40.855Z","default",[],1788773395,[],[],{"cache-control":53,"connection":54,"content-encoding":55,"content-type":56,"date":57,"etag":58,"referrer-policy":59,"sb-be-version":60,"server":61,"transfer-encoding":62,"vary":63,"via":64,"x-amz-cf-id":65,"x-amz-cf-pop":66,"x-cache":67,"x-content-type-options":68,"x-frame-options":69,"x-permitted-cross-domain-policies":70,"x-ratelimit":71,"x-ratelimit-policy":72,"x-request-id":73,"x-runtime":74,"x-xss-protection":75},"max-age=0, private, must-revalidate","keep-alive","gzip","application/json; charset=utf