[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"{\"version\":\"draft\"}zajecia/taniec-wspolczesny":3},{"data":4,"headers":53},{"story":5,"cv":50,"rels":51,"links":52},{"name":6,"created_at":7,"published_at":8,"updated_at":9,"id":10,"uuid":11,"content":12,"slug":40,"full_slug":41,"sort_by_date":42,"position":43,"tag_list":44,"is_startpage":23,"parent_id":45,"meta_data":42,"group_id":46,"first_published_at":47,"release_id":42,"lang":48,"path":42,"alternates":49,"default_full_slug":42,"translated_slugs":42},"Taniec Współczesny","2026-05-29T15:53:58.622Z","2026-05-31T14:52:00.007Z","2026-05-31T14:52:00.019Z",181782276619429,"d4d0b973-3c16-4ddb-bf42-d53dcb21f772",{"_uid":13,"body":14,"component":38,"_editable":39},"f60e9f23-22ff-4531-b05a-302e440a0458",[15,32],{"_uid":16,"icon":17,"image":24,"title":28,"component":29,"description":30,"_editable":31},"6b77c262-b265-4334-a815-920524b58abf",{"id":18,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":20,"copyright":19,"fieldtype":21,"meta_data":22,"is_external_url":23},182472183752864,"","https://a.storyblok.com/f/295402/3000x2000/76504f1134/projekt-bez-nazwy-79.png","asset",{},false,{"id":25,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":26,"copyright":19,"fieldtype":21,"meta_data":27,"is_external_url":23},181783828667860,"https://a.storyblok.com/f/295402/3000x1000/c03aecf39f/projekt-bez-nazwy-39.png",{},"Taniec Wsppółczesny","ClassDetailsContent","Taniec współczesny to forma ruchu łącząca technikę taneczną z naturalnością, swobodą i wyrażaniem emocji. Zajęcia pozwalają dzieciom odkrywać możliwości własnego ciała, rozwijać kreatywność oraz uczyć się świadomego poruszania w rytmie muzyki.\n\nPodczas treningów uczestnicy poznają podstawowe elementy techniki tańca współczesnego, uczą się płynnych przejść, skoków, obrotów oraz choreografii dostosowanych do wieku i poziomu zaawansowania. Dużą rolę odgrywa również praca nad dynamiką ruchu, koordynacją oraz interpretacją muzyki.\n\nRegularne zajęcia rozwijają gibkość, siłę, równowagę \ni świadomość ciała. Pomagają także budować pewność siebie, wrażliwość artystyczną oraz umiejętność wyrażania emocji poprzez ruch. Taniec współczesny uczy kreatywnego myślenia, koncentracji i swobody scenicznej.\n\nZajęcia prowadzone są w przyjaznej atmosferze, sprzyjającej rozwojowi i dobrej zabawie. Dzięki połączeniu techniki tanecznej z twórczą ekspresją każde dziecko może rozwijać swoją pasję do tańca, czerpać radość z ruchu oraz odkrywać własny styl.\n\n•••••••••••••••••••••••••••••••••••••••\n\n░░░ 𝐆𝐑𝐀𝐅𝐈𝐊 ░░░\nPiątek:\n18:30 - 8+ lat - OPEN\n","\u003C!--#storyblok#{\"name\": \"ClassDetailsContent\", \"space\": \"295402\", \"uid\": \"6b77c262-b265-4334-a815-920524b58abf\", \"id\": \"181782276619429\"}-->",{"_uid":33,"title":34,"images":35,"component":36,"_editable":37},"214d1813-4e15-43bb-a36f-8dceaa0c4a5b","TEST",[],"ClassGallery","\u003C!--#storyblok#{\"name\": \"ClassGallery\", \"space\": \"295402\", \"uid\": \"214d1813-4e15-43bb-a36f-8dceaa0c4a5b\", \"id\": \"181782276619429\"}-->","page","\u003C!--#storyblok#{\"name\": \"page\", \"space\": \"295402\", \"uid\": \"f60e9f23-22ff-4531-b05a-302e440a0458\", \"id\": \"181782276619429\"}-->","taniec-wspolczesny","zajecia/taniec-wspolczesny",null,-10,[],180832269008996,"7cc417c2-3c39-4ca8-a066-8dec7d38b2ec","2026-05-31T13:21:16.700Z","default",[],1788773395,[],[],{"cache-control":54,"connection":55,"content-encoding":56,"content-type":57,"date":58,"etag":59,"referrer-policy":60,"sb-be-version":61,"server":62,"transfer-encoding":63,"vary":64,"via":65,"x-amz-cf-id":66,"x-amz-cf-pop":67,"x-cache":68,"x-content-type-options":69,"x-frame-options":70,"x-permitted-cross-domain-policies":71,"x-ratelimit":72,"x-ratelimit-policy":73,"x-request-id":74,"x-runtime":75,"x-xss-protection":76},"max-age=0, private, must-revalidate","keep-alive","gzip","application/json; charset=utf-8","Mon, 07 Sep 2026 09:38:15 GMT","W/\"18bb73476c5f760149fd0e26b7d7c7d2\"","strict-origin-when-cross-origin",