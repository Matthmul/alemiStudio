[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"{\"version\":\"draft\"}zajecia/zumba-kids":3},{"data":4,"headers":52},{"story":5,"cv":49,"rels":50,"links":51},{"name":6,"created_at":7,"published_at":8,"updated_at":9,"id":10,"uuid":11,"content":12,"slug":39,"full_slug":40,"sort_by_date":41,"position":42,"tag_list":43,"is_startpage":23,"parent_id":44,"meta_data":41,"group_id":45,"first_published_at":46,"release_id":41,"lang":47,"path":41,"alternates":48,"default_full_slug":41,"translated_slugs":41},"Zumba Kids","2026-05-29T15:22:19.992Z","2026-05-31T14:52:11.885Z","2026-05-31T14:52:11.900Z",181774499884551,"fea32c55-3b0e-42dd-ab12-07978e74f156",{"_uid":13,"body":14,"component":37,"_editable":38},"f60e9f23-22ff-4531-b05a-302e440a0458",[15,31],{"_uid":16,"icon":17,"image":24,"title":6,"component":28,"description":29,"_editable":30},"6b77c262-b265-4334-a815-920524b58abf",{"id":18,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":20,"copyright":19,"fieldtype":21,"meta_data":22,"is_external_url":23},181775686393128,"","https://a.storyblok.com/f/295402/2000x1500/d8ddf33d03/projekt-bez-nazwy-34.png","asset",{},false,{"id":25,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":26,"copyright":19,"fieldtype":21,"meta_data":27,"is_external_url":23},181754590275487,"https://a.storyblok.com/f/295402/2000x1500/d6443444f5/projekt-bez-nazwy-24.png",{},"ClassDetailsContent","Zumba Kids to pełne energii zajęcia taneczno-ruchowe stworzone specjalnie dla dzieci. Łączą proste kroki taneczne z zabawą, muzyką i aktywnością fizyczną, dzięki czemu uczestnicy mogą rozwijać swoją sprawność w radosnej\n i motywującej atmosferze.\n\nPodczas zajęć dzieci uczą się łatwych choreografii do dynamicznej, różnorodnej muzyki. Treningi obejmują elementy tańca, ćwiczenia ogólnorozwojowe oraz zabawy ruchowe, które angażują całe ciało i zachęcają do aktywności.\n\nRegularny udział w zajęciach poprawia koordynację ruchową, poczucie rytmu, kondycję oraz świadomość własnego ciała. Zumba Kids pomaga również rozwijać pewność siebie, kreatywność i umiejętność współpracy w grupie. \nDzięki połączeniu ruchu i muzyki dzieci uczą się wyrażania emocji oraz czerpią radość z aktywności fizycznej.\n\nZajęcia prowadzone są w przyjaznej atmosferze, dostosowane do wieku i możliwości uczestników. \nTo doskonały sposób na aktywne spędzanie czasu, rozwijanie pasji do tańca oraz budowanie zdrowych nawyków ruchowych już od najmłodszych lat.\n\n•••••••••••••••••••••••••••••••••••••••\n░░░ 𝐆𝐑𝐀𝐅𝐈𝐊 ░░░\n\nPoniedziałek:\n16:00 - 4–6 lat\n\nŚroda:\n18:30 - 7+ lat","\u003C!--#storyblok#{\"name\": \"ClassDetailsContent\", \"space\": \"295402\", \"uid\": \"6b77c262-b265-4334-a815-920524b58abf\", \"id\": \"181774499884551\"}-->",{"_uid":32,"title":33,"images":34,"component":35,"_editable":36},"214d1813-4e15-43bb-a36f-8dceaa0c4a5b","TEST",[],"ClassGallery","\u003C!--#storyblok#{\"name\": \"ClassGallery\", \"space\": \"295402\", \"uid\": \"214d1813-4e15-43bb-a36f-8dceaa0c4a5b\", \"id\": \"181774499884551\"}-->","page","\u003C!--#storyblok#{\"name\": \"page\", \"space\": \"295402\", \"uid\": \"f60e9f23-22ff-4531-b05a-302e440a0458\", \"id\": \"181774499884551\"}-->","zumba-kids","zajecia/zumba-kids",null,-30,[],180832269008996,"7551b29b-2c40-4522-9338-6f0fbb0d87a5","2026-05-31T13:21:34.873Z","default",[],1788773395,[],[],{"cache-control":53,"connection":54,"content-encoding":55,"content-type":56,"date":57,"etag":58,"referrer-policy":59,"sb-be-version":60,"server":61,"transfer-encoding":62,"vary":63,"via":64,"x-amz-cf-id":65,"x-amz-cf-pop":66,"x-cache":67,"x-content-type-options":68,"x-frame-options":69,"x-permitted-cross-domain-policies":70,"x-ratelimit":71,"x-ratelimit-policy":72,"x-request-id":73,"x-runtime":74,"x-xss-protection":75},"max-age=0, private, must-revalidate","keep-alive","gzip","application/json; charset=utf-8","Mon, 07 Sep 2026 09:38:15 GMT","W/\"91eecda82e3aaa879e1eb7d67b909639\"","strict-origin-when-cross-origin","5.959.0","nginx/1.29.1","chunked","Origi