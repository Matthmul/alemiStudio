[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"{\"version\":\"draft\"}zajecia/acro-ninja":3},{"data":4,"headers":52},{"story":5,"cv":49,"rels":50,"links":51},{"name":6,"created_at":7,"published_at":8,"updated_at":9,"id":10,"uuid":11,"content":12,"slug":39,"full_slug":40,"sort_by_date":41,"position":42,"tag_list":43,"is_startpage":23,"parent_id":44,"meta_data":41,"group_id":45,"first_published_at":46,"release_id":41,"lang":47,"path":41,"alternates":48,"default_full_slug":41,"translated_slugs":41},"Acro Ninja","2026-05-29T15:06:13.203Z","2026-05-31T14:51:55.689Z","2026-05-31T14:51:55.701Z",181770539870423,"c74cecc5-1ed2-46f0-a74c-328e399e1d66",{"_uid":13,"body":14,"component":37,"_editable":38},"f60e9f23-22ff-4531-b05a-302e440a0458",[15,31],{"_uid":16,"icon":17,"image":24,"title":6,"component":28,"description":29,"_editable":30},"6b77c262-b265-4334-a815-920524b58abf",{"id":18,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":20,"copyright":19,"fieldtype":21,"meta_data":22,"is_external_url":23},182470926989466,"","https://a.storyblok.com/f/295402/3000x2000/262b7d3029/projekt-bez-nazwy-75.png","asset",{},false,{"id":25,"alt":19,"name":19,"focus":19,"title":19,"source":19,"filename":26,"copyright":19,"fieldtype":21,"meta_data":27,"is_external_url":23},181753626568538,"https://a.storyblok.com/f/295402/1536x1024/8b5bd0c7d4/chatgpt-image-29-maj-2026-15_57_08.png",{},"ClassDetailsContent","Acro Ninja to dynamiczne zajęcia inspirowane akrobatyką, parkourem oraz treningiem sprawnościowym. To idealna propozycja dla dzieci pełnych energii, które lubią ruch, wyzwania i aktywną zabawę. Treningi rozwijają sprawność fizyczną poprzez pokonywanie różnorodnych torów przeszkód oraz naukę efektownych elementów akrobatycznych.\n\nPodczas zajęć uczestnicy ćwiczą skoki, przewroty, podpory, zwisy, równowagę oraz bezpieczne pokonywanie przeszkód. Dzieci uczą się kontroli nad własnym ciałem, szybkiego reagowania oraz podejmowania nowych wyzwań \nw bezpiecznych warunkach.\n\nRegularne treningi wzmacniają siłę, wytrzymałość, koordynację i zwinność. Zajęcia pomagają również rozwijać odwagę, koncentrację, samodyscyplinę oraz umiejętność współpracy w grupie. Każde kolejne wyzwanie daje dzieciom poczucie sukcesu i motywuje do dalszego rozwoju.\n\nZajęcia prowadzone są w formie aktywnej zabawy, dostosowanej do wieku i możliwości uczestników. \nDzięki różnorodnym ćwiczeniom oraz przyjaznej atmosferze dzieci mogą rozwijać swoje umiejętności ruchowe, budować pewność siebie i czerpać radość z aktywności fizycznej.\n\n•••••••••••••••••••••••••••••••••••••••\n░░░ 𝐆𝐑𝐀𝐅𝐈𝐊 ░░░\n\n\nPoniedziałek:\n16:30 - 7–10 lat\n\nCzwartek:\n16:30 - 3–4 lata\n\nPiątek:\n16:30 - 5–6 lat\n\nSobota:\n10:00 - 6–10 lat","\u003C!--#storyblok#{\"name\": \"ClassDetailsContent\", \"space\": \"295402\", \"uid\": \"6b77c262-b265-4334-a815-920524b58abf\", \"id\": \"181770539870423\"}-->",{"_uid":32,"title":33,"images":34,"component":35,"_editable":36},"214d1813-4e15-43bb-a36f-8dceaa0c4a5b","TEST",[],"ClassGallery","\u003C!--#storyblok#{\"name\": \"ClassGallery\", \"space\": \"295402\", \"uid\": \"214d1813-4e15-43bb-a36f-8dceaa0c4a5b\", \"id\": \"181770539870423\"}-->","page","\u003C!--#storyblok#{\"name\": \"page\", \"space\": \"295402\", \"uid\": \"f60e9f23-22ff-4531-b05a-302e440a0458\", \"id\": \"181770539870423\"}-->","acro-ninja","zajecia/acro-ninja",null,-30,[],180832269008996,"4cfa2834-d2aa-47c6-b609-57e7dca784ce","2026-05-31T13:21:31.865Z","default",[],1788773395,[],[],{"cache-control":53,"connection":54,"content-encoding":55,"content-type":56,"date":57,"etag":58,"referrer-policy":59,"sb-be-version":60,"server":61,"transfer-encoding":62,"vary":63,"via":64,"x-amz-cf-id":65,"x-amz-cf-pop":66,"x-cache":67,"x-content-type-options":68,"x-frame-options":69,"x-permitted-cross-domain-policies":70,"x-ratelimit":71,"x-ratelimit-policy":72,"x-request-id":73,"x-runtime":74,"x-xss-protection":75},"max-age=0, private, must-revalidate","keep-alive","gzip","application/json; charset=